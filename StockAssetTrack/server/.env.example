APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:5001
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5174,http://127.0.0.1:5174

# Adobe Stock Data Adapter: demo | official
ADOBE_DATA_MODE=demo
ADOBE_API_KEY=
ADOBE_PRODUCT_HEADER=StockAssetTrack/1.0

# MySQL / MariaDB (XAMPP default local values)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=stockassettrack
DB_USER=root
DB_PASS=

# Security & AI Integrations (configured in later phases)
APP_SECRET=change-this-dev-secret-before-production
CRON_SECRET=change-this-cron-secret
REQUIRE_AUTH_FOR_METERED=false
AUTH_TOKEN_TTL_SECONDS=604800
GEMINI_API_KEY=
OPENAI_API_KEY=
TURNSTILE_SECRET_KEY=

# Mail & SMTP Verification Settings (Gmail or Hostinger)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM_ADDRESS=support@stockassettrack.com
MAIL_FROM_NAME=StockAssetTrack
AUTO_VERIFY_SIGNUP=false

# Multi-Gateway Billing Webhooks
STRIPE_WEBHOOK_SECRET=
CREEM_WEBHOOK_SECRET=
CRYPTOMUS_API_KEY=
