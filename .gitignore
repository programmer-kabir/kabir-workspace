# Dependencies
**/node_modules/
**/vendor/

# Production & Build outputs
**/dist/
**/build/
**/.next/
**/out/
**/release/
**/*.exe
**/*.dll
**/*.bin

# Environment variables & secrets
**/.env
**/.env.local
**/.env.*
!**/.env.example
**/google_drive_credentials.json

# Database & Large Dumps
**/*.sql
**/server/backups/*
!**/server/backups/.htaccess
!**/server/backups/.gitkeep

# Logs
**/*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# System & Cache files
.DS_Store
Thumbs.db
desktop.ini

# IDE & Editor files
.vscode/
.idea/

# Large backups and archives
**/*.zip
**/*.rar
**/*.7z
**/*.tar.gz
**/.git_backup
