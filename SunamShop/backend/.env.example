# SUNAM SHOP — Backend Environment Template
APP_NAME="Sunam Shop"
APP_ENV="development"
APP_DEBUG=true
APP_URL="http://localhost:8000"
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001"

# Database Configuration (MySQL / MariaDB)
DB_HOST="127.0.0.1"
DB_PORT=3306
DB_DATABASE="sunam_shop"
DB_USERNAME="root"
DB_PASSWORD=""
DB_CHARSET="utf8mb4"

# Authentication & Security
JWT_SECRET="replace_with_a_secure_random_64_character_key"
JWT_EXPIRATION_HOURS=72
SESSION_COOKIE_NAME="sunam_shop_session"

# Currency & Localization
DEFAULT_CURRENCY="BDT"
DEFAULT_LOCALE="bn"
