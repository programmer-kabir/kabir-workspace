# public_html/.htaccess - SPA fallback (static build)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # don't rewrite existing files or directories
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # don't rewrite API or uploads folders (so PHP endpoints and uploaded files work directly)
  RewriteRule ^apis/ - [L]
  RewriteRule ^api/ - [L]
  RewriteRule ^cron/ - [L]
  RewriteRule ^uploads/ - [L]

  # everything else -> serve index.html (React Router will handle path)
  RewriteRule ^ index.html [L,QSA]
</IfModule>
