# ==========================================
# Creative Computer Academy (CCA) Server Env Template
# ==========================================

# Database Configuration
DB_HOST=localhost
DB_NAME=u647959341_cca_manage_db
DB_USER=root
DB_PASS=

# Cloudflare R2 Storage Configuration
R2_ACCOUNT_ID=your_cloudflare_r2_account_id
R2_ACCESS_KEY_ID=your_cloudflare_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_cloudflare_r2_secret_access_key
R2_BUCKET_NAME=cca-task-attachments
R2_STUDENT_BUCKET_NAME=cca-student-submissions
R2_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://pub-xxxxxx.r2.dev
R2_REGION=auto

# Pusher Realtime Configuration
PUSHER_APP_ID=your_pusher_app_id
PUSHER_KEY=your_pusher_key
PUSHER_SECRET=your_pusher_secret
PUSHER_CLUSTER=ap2

# OpenRouter / Gemini AI API Configuration
OPENROUTER_API_KEY=your_openrouter_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# SMTP / Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM_NAME="CCA Notifications"

# Google Drive 5TB Storage Configuration (Optional)
GOOGLE_DRIVE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_DRIVE_CLIENT_SECRET=your_google_client_secret
GOOGLE_DRIVE_REFRESH_TOKEN=your_google_refresh_token
GOOGLE_DRIVE_USER_EMAIL=your_email@gmail.com

