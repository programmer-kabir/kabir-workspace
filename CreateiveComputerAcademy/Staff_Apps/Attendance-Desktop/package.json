{
  "name": "cca-staff-desktop",
  "version": "2.0.0",
  "description": "Creative Computer Academy - Desktop Staff Workstation & Management App",
  "main": "electron/main.cjs",
  "type": "module",
  "author": "Creative Computer Academy",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "electron .",
    "desktop:dev": "concurrently -k \"vite --port 5180\" \"wait-on tcp:5180 && electron . --dev\"",
    "dist": "vite build && electron-builder --win",
    "dist:portable": "vite build && electron-builder --win portable",
    "dist:fast": "vite build && electron-builder --win portable -c.compression=store",
    "dist:dir": "vite build && electron-builder --dir",
    "dist:nsis": "vite build && electron-builder --win nsis"
  },
  "build": {
    "appId": "com.creativecomputeracademy.staff",
    "productName": "CCA Staff App",
    "copyright": "Copyright © 2026 Creative Computer Academy",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "public/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "public/favicon.ico",
        "to": "favicon.ico"
      },
      {
        "from": "public/logo.png",
        "to": "logo.png"
      },
      {
        "from": "electron/input_injector.exe",
        "to": "input_injector.exe"
      }
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "public/logo.png"
    },
    "portable": {
      "artifactName": "CCA-Staff-App-Standalone.exe"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CCA Staff App",
      "artifactName": "CCA-Staff-App-Setup.exe"
    }
  },
  "dependencies": {
    "axios": "^1.7.9",
    "framer-motion": "^14.3.0",
    "pusher-js": "^8.6.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-icons": "^5.4.0",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^35.0.0",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4.0.0",
    "vite": "^6.2.0",
    "wait-on": "^8.0.2"
  }
}
