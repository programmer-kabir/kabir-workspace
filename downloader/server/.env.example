PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173,http://localhost:5175,http://127.0.0.1:5175,http://localhost:3000

# Database Engine Selection (MongoDB Atlas is the sole supported engine)
DB_ENGINE=mongodb

# MongoDB Atlas Configuration (Required)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/StreamVault?retryWrites=true&w=majority
MONGODB_DB_NAME=StreamVault
MONGODB_MAX_POOL_SIZE=10
MONGODB_MIN_POOL_SIZE=2
MONGODB_CONNECT_TIMEOUT_MS=5000
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
